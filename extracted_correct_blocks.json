{
  "proof_switcher": "<section class=\"weflair-section weflair-proof weflair-proof--switcher\" id=\"proof\">\n      <div class=\"container\">\n        <div class=\"weflair-proof__layout\">\n          <div class=\"weflair-proof__head\">\n            <p class=\"weflair-proof__overline\">Case studies</p>\n            <h2 class=\"h3\">Proven results.</h2>\n            <p class=\"weflair-section__body\">Measurable growth across ecommerce, CRM, and paid media.</p>\n          </div>\n          <div class=\"weflair-proof-switcher\" data-proof-switcher>\n            <button type=\"button\" class=\"weflair-proof-switcher__nav is-prev\" data-proof-nav-prev aria-label=\"Show previous case study\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                <polyline points=\"15 18 9 12 15 6\"></polyline>\n              </svg>\n            </button>\n            <div class=\"weflair-proof-switcher__shell\">\n              <article class=\"weflair-proof-feature\" data-proof-type>\n                <!-- TYPE A: heydigital - info left, visual right -->\n                <div class=\"weflair-proof-feature__info\">\n                  <div class=\"weflair-proof-feature__logo\" data-proof-logo></div>\n                  <h3 class=\"weflair-proof-feature__headline\" data-proof-headline></h3>\n                  <p class=\"weflair-proof-feature__desc\" data-proof-desc></p>\n                  <div class=\"weflair-proof-feature__metrics\" data-proof-metrics></div>\n                  <a href=\"/case-studies/\" class=\"weflair-proof-feature__link\" data-proof-link>\n                    Read full results <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg>\n                  </a>\n                </div>\n                <div class=\"weflair-proof-feature__visual\">\n                  <div class=\"weflair-proof-feature__photo\" data-proof-photo></div>\n                </div>\n                <div class=\"weflair-proof-feature__ad-grid\" data-proof-ad-grid></div>\n\n                <!-- TYPE B: netpeak - logo | center | stats -->\n                <div class=\"weflair-proof-feature__np-logo\" data-proof-np-logo></div>\n                <div class=\"weflair-proof-feature__np-center\">\n                  <div class=\"weflair-proof-feature__np-photo\" data-proof-np-photo></div>\n                  <p class=\"weflair-proof-feature__np-desc\" data-proof-np-desc></p>\n                  <div class=\"weflair-proof-feature__np-meta\" data-proof-np-meta></div>\n                  <a href=\"/case-studies/\" class=\"weflair-proof-feature__np-cta\" data-proof-np-cta>Read full case &rarr;</a>\n                </div>\n                <div class=\"weflair-proof-feature__np-stats\" data-proof-np-stats></div>\n\n                <!-- shared dots -->\n                <div class=\"weflair-proof-feature__dots-row\">\n                  <div class=\"weflair-proof-switcher__dots\" data-proof-dots></div>\n                </div>\n              </article>\n              <div class=\"weflair-proof-switcher__rails\" data-proof-rails></div>\n            </div>\n            <button type=\"button\" class=\"weflair-proof-switcher__nav is-next\" data-proof-nav-next aria-label=\"Show next case study\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                <polyline points=\"9 18 15 12 9 6\"></polyline>\n              </svg>\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>",
  "playbooks": "<section class=\"weflair-playbooks weflair-section\" id=\"playbooks\">\n      <div class=\"container\">\n        <div class=\"weflair-section__head\">\n          <div class=\"eyebrow is-centered\"><span class=\"weflair-eyebrow-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 34 45\" fill=\"none\" class=\"weflair-flare\">\n                <path\n                  d=\"M15.875 2.188c.102 0 .207.187.312.562.051.25.102.469.156.656.781 2.867 2.488 5.531 5.125 8 2.633 2.461 5.492 4.074 8.578 4.844.289.055.438.164.438.328 0 .188-.157.309-.47.36-3.218.7-6.214 2.452-8.984 5.265-2.773 2.812-4.453 5.625-5.047 8.438-.074.258-.18.39-.313.39-.167 0-.26-.148-.28-.437-.274-1.445-.856-2.957-1.75-4.532-.899-1.582-1.965-2.96-3.203-4.14-1.063-1.071-2.508-2.145-4.328-3.22-1.824-1.07-3.246-1.71-4.266-1.921-.293-.082-.438-.203-.438-.36 0-.187.395-.379 1.188-.577.789-.207 1.926-.688 3.406-1.438 1.488-.75 2.89-1.805 4.203-3.172 1.344-1.363 2.516-2.851 3.516-4.468s1.61-2.992 1.828-4.117c.051-.3.16-.453.328-.453Z\"\n                  fill=\"currentColor\"></path>\n              </svg></span>\n            <p class=\"eyebrow__p\">Playbooks</p>\n          </div>\n          <h2 class=\"h3\">Proven plays for <span class=\"weflair-section-accent weflair-section-accent--solid\">every\n              growth motion</span></h2>\n          <p class=\"weflair-section__body\">B2B or DTC, outbound or inbound &mdash; every playbook is a system, not a\n            tactic. Built on signals, sequenced for conversion, and ready to run.</p>\n        </div>\n        <div class=\"weflair-playbooks-grid\">\n          <div class=\"weflair-playbook-card\">\n            <div class=\"weflair-playbook-card__icon\" style=\"background:#3eff6822;color:#3eff68\"><svg\n                xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <circle cx=\"18\" cy=\"5\" r=\"3\" />\n                <circle cx=\"6\" cy=\"12\" r=\"3\" />\n                <circle cx=\"18\" cy=\"19\" r=\"3\" />\n                <path d=\"m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98\" />\n              </svg></div>\n            <div class=\"weflair-playbook-card__body\">\n              <p class=\"weflair-playbook-card__tag\">B2B - Outbound</p>\n              <h3 class=\"weflair-playbook-card__title\">Lookalike Outbound</h3>\n              <p class=\"weflair-playbook-card__desc\">Find an evergreen stream of cold prospects that match your best-fit\n                customers, then sequence them automatically.</p>\n              <a href=\"/services/paid-media-performance.html\" class=\"weflair-playbook-card__btn\"><svg\n                  xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                  stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                  <polyline points=\"7 10 12 15 17 10\" />\n                  <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" />\n                </svg> Get the playbook</a>\n            </div>\n          </div>\n          <div class=\"weflair-playbook-card\">\n            <div class=\"weflair-playbook-card__icon\" style=\"background:#5eead422;color:#5eead4\"><svg\n                xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z\" />\n                <circle cx=\"12\" cy=\"12\" r=\"3\" />\n              </svg></div>\n            <div class=\"weflair-playbook-card__body\">\n              <p class=\"weflair-playbook-card__tag\">B2B - Inbound</p>\n              <h3 class=\"weflair-playbook-card__title\">Visitor Deanonymization</h3>\n              <p class=\"weflair-playbook-card__desc\">Identify companies visiting your site and trigger personalised\n                outreach before they contact a competitor.</p>\n              <a href=\"resources/playbooks.html\" class=\"weflair-playbook-card__btn\"><svg\n                  xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                  stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                  <polyline points=\"7 10 12 15 17 10\" />\n                  <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" />\n                </svg> Get the playbook</a>\n            </div>\n          </div>\n          <div class=\"weflair-playbook-card\">\n            <div class=\"weflair-playbook-card__icon\" style=\"background:#818cf822;color:#818cf8\"><svg\n                xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\" />\n                <path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\" />\n              </svg></div>\n            <div class=\"weflair-playbook-card__body\">\n              <p class=\"weflair-playbook-card__tag\">B2B & B2C - Email</p>\n              <h3 class=\"weflair-playbook-card__title\">Direct Outreach Campaign</h3>\n              <p class=\"weflair-playbook-card__desc\">Reach prospects via personal, low-competition channels &mdash;\n                email sequences built to earn replies, not land in spam.</p>\n              <a href=\"resources/playbooks.html\" class=\"weflair-playbook-card__btn\"><svg\n                  xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                  stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                  <polyline points=\"7 10 12 15 17 10\" />\n                  <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" />\n                </svg> Get the playbook</a>\n            </div>\n          </div>\n          <div class=\"weflair-playbook-card\">\n            <div class=\"weflair-playbook-card__icon\" style=\"background:#fbbf2422;color:#fbbf24\"><svg\n                xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M2 20h.01M7 20v-4M12 20V10M17 20V4M22 20v-8\" />\n              </svg></div>\n            <div class=\"weflair-playbook-card__body\">\n              <p class=\"weflair-playbook-card__tag\">B2B - Social</p>\n              <h3 class=\"weflair-playbook-card__title\">Social Signals Campaign</h3>\n              <p class=\"weflair-playbook-card__desc\">Target buyers who are actively showing intent on LinkedIn and\n                social &mdash; engage them at exactly the right moment.</p>\n              <a href=\"resources/playbooks.html\" class=\"weflair-playbook-card__btn\"><svg\n                  xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                  stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                  <polyline points=\"7 10 12 15 17 10\" />\n                  <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" />\n                </svg> Get the playbook</a>\n            </div>\n          </div>\n          <div class=\"weflair-playbook-card\">\n            <div class=\"weflair-playbook-card__icon\" style=\"background:#f472b622;color:#f472b6\"><svg\n                xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M6 15H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2\" />\n                <path d=\"M6 15v3a6 6 0 0 0 12 0v-3\" />\n              </svg></div>\n            <div class=\"weflair-playbook-card__body\">\n              <p class=\"weflair-playbook-card__tag\">B2B & B2C - Lead</p>\n              <h3 class=\"weflair-playbook-card__title\">Lead Magnet Campaign</h3>\n              <p class=\"weflair-playbook-card__desc\">Create an offer prospects can&rsquo;t refuse, capture demand at\n                scale, and route leads directly into your CRM.</p>\n              <a href=\"resources/playbooks.html\" class=\"weflair-playbook-card__btn\"><svg\n                  xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                  stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                  <polyline points=\"7 10 12 15 17 10\" />\n                  <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" />\n                </svg> Get the playbook</a>\n            </div>\n          </div>\n          <div class=\"weflair-playbook-card\">\n            <div class=\"weflair-playbook-card__icon\" style=\"background:#fb923c22;color:#fb923c\"><svg\n                xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\" />\n                <polyline points=\"14 2 14 8 20 8\" />\n                <line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\" />\n                <line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\" />\n                <polyline points=\"10 9 9 9 8 9\" />\n              </svg></div>\n            <div class=\"weflair-playbook-card__body\">\n              <p class=\"weflair-playbook-card__tag\">B2B - Proof</p>\n              <h3 class=\"weflair-playbook-card__title\">Case Study Campaign</h3>\n              <p class=\"weflair-playbook-card__desc\">Turn your existing wins into qualified pipeline &mdash; use social\n                proof to bring in more ICPs who look like your best clients.</p>\n              <a href=\"resources/playbooks.html\" class=\"weflair-playbook-card__btn\"><svg\n                  xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                  stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                  <polyline points=\"7 10 12 15 17 10\" />\n                  <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" />\n                </svg> Get the playbook</a>\n            </div>\n          </div>\n        </div>\n        <div class=\"weflair-playbooks-footer\"><a data-hover=\"\" data-btn-theme=\"transparent\" href=\"/sitemap.html\"\n            class=\"btn w-inline-block weflair-btn weflair-btn--ghost\">\n            <div class=\"btn__bg\"></div>\n            <div class=\"btn__text\"><span class=\"btn__span\">Discover all our resources</span></div>\n            <div class=\"arrow\">\n              <div class=\"arrow__bg\"></div>\n              <div class=\"arrow__box is--duplicate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\"\n                  viewBox=\"0 0 24 24\" fill=\"none\" class=\"arrow__svg\">\n                  <path d=\"M7 17L17 7\" stroke=\"currentColor\" stroke-width=\"0.125em\" stroke-linecap=\"square\" />\n                  <path d=\"M7 7h10v10\" stroke=\"currentColor\" stroke-width=\"0.125em\" stroke-linecap=\"square\" />\n                </svg></div>\n              <div class=\"arrow__box\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" viewBox=\"0 0 24 24\"\n                  fill=\"none\" class=\"arrow__svg\">\n                  <path d=\"M7 17L17 7\" stroke=\"currentColor\" stroke-width=\"0.125em\" stroke-linecap=\"square\" />\n                  <path d=\"M7 7h10v10\" stroke=\"currentColor\" stroke-width=\"0.125em\" stroke-linecap=\"square\" />\n                </svg></div>\n            </div>\n          </a></div>\n      </div>\n    </section>",
  "resources_teaser": "<section class=\"weflair-section weflair-resources-teaser\" id=\"resources-teaser\">\n      <div class=\"container\">\n        <div class=\"weflair-resources-teaser__layout\">\n          <div class=\"weflair-resources-teaser__head\">\n            <h2 class=\"h3\">Everything in the open.</h2>\n            <p class=\"weflair-section__body\">We don't gatekeep. The playbooks, tools, and thinking we use - yours to take.</p>\n          </div>\n          <div class=\"weflair-resources-teaser__grid\">\n            <a href=\"/resources/playbooks.html\" class=\"weflair-resource-card\" aria-label=\"Browse guides and playbooks\">\n              <div class=\"weflair-resource-card__glow\" style=\"--glow-x:20%;--glow-y:12%;--glow-color:62,255,104\"></div>\n              <span class=\"weflair-resource-card__icon-wrap\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20\" stroke=\"url(#playbook-g)\"/>\n                  <path d=\"M8 7h8M8 11h5\" stroke=\"url(#playbook-g)\" opacity=\".7\"/>\n                  <defs><linearGradient id=\"playbook-g\" x1=\"4\" y1=\"2\" x2=\"20\" y2=\"22\" gradientUnits=\"userSpaceOnUse\"><stop stop-color=\"#3eff68\"/><stop offset=\"1\" stop-color=\"#2dd4bf\"/></linearGradient></defs>\n                </svg>\n              </span>\n              <h3 class=\"weflair-resource-card__title\">Guides &amp; Playbooks</h3>\n              <p class=\"weflair-resource-card__body\">Practical playbooks and deeper growth guides for positioning, creative, paid media, GTM, and execution.</p>\n              <div class=\"weflair-resource-card__samples\"><span>B2B</span><span>B2C</span><span>Paid media</span><span>GTM</span></div>\n              <span class=\"weflair-resource-card__link\">Browse guides &amp; playbooks <span aria-hidden=\"true\">&rarr;</span></span>\n            </a>\n            <a href=\"/resource-pack.html\" class=\"weflair-resource-card\" aria-label=\"Get the resource pack\">\n              <div class=\"weflair-resource-card__glow\" style=\"--glow-x:80%;--glow-y:8%;--glow-color:111,136,255\"></div>\n              <span class=\"weflair-resource-card__icon-wrap\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\" stroke=\"url(#auto-g)\" fill=\"url(#auto-g)\" fill-opacity=\".08\"/>\n                  <circle cx=\"12\" cy=\"12\" r=\"3.5\" stroke=\"url(#auto-g2)\" stroke-dasharray=\"2.5 2\"/>\n                  <defs>\n                    <linearGradient id=\"auto-g\" x1=\"2\" y1=\"2\" x2=\"22\" y2=\"22\" gradientUnits=\"userSpaceOnUse\"><stop stop-color=\"#6f88ff\"/><stop offset=\"1\" stop-color=\"#a78bfa\"/></linearGradient>\n                    <linearGradient id=\"auto-g2\" x1=\"8\" y1=\"8\" x2=\"16\" y2=\"16\" gradientUnits=\"userSpaceOnUse\"><stop stop-color=\"#6f88ff\"/><stop offset=\"1\" stop-color=\"#c084fc\"/></linearGradient>\n                  </defs>\n                </svg>\n              </span>\n              <h3 class=\"weflair-resource-card__title\">Resource Pack</h3>\n              <p class=\"weflair-resource-card__body\">AI skills, sales and marketing automations, templates, and practical tools for cleaner GTM work.</p>\n              <div class=\"weflair-resource-card__samples\"><span>AI skills</span><span>Templates</span><span>Automations</span><span>Tools</span></div>\n              <span class=\"weflair-resource-card__link\">Get the resource pack <span aria-hidden=\"true\">&rarr;</span></span>\n            </a>\n            <a href=\"/resources/checklists.html\" class=\"weflair-resource-card\" aria-label=\"Open ads checklist\">\n              <div class=\"weflair-resource-card__glow\" style=\"--glow-x:70%;--glow-y:14%;--glow-color:255,187,51\"></div>\n              <span class=\"weflair-resource-card__icon-wrap\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M8 6h10M8 12h10M8 18h6\" stroke=\"url(#checklist-g)\"/>\n                  <path d=\"m3 6 1.4 1.4L6.8 5\" stroke=\"url(#checklist-g2)\"/>\n                  <path d=\"m3 12 1.4 1.4L6.8 11\" stroke=\"url(#checklist-g2)\"/>\n                  <path d=\"m3 18 1.4 1.4L6.8 17\" stroke=\"url(#checklist-g2)\"/>\n                  <defs>\n                    <linearGradient id=\"checklist-g\" x1=\"8\" y1=\"6\" x2=\"18\" y2=\"18\" gradientUnits=\"userSpaceOnUse\"><stop stop-color=\"#ffbb33\"/><stop offset=\"1\" stop-color=\"#ff7a1a\"/></linearGradient>\n                    <linearGradient id=\"checklist-g2\" x1=\"3\" y1=\"5\" x2=\"7\" y2=\"19\" gradientUnits=\"userSpaceOnUse\"><stop stop-color=\"#ffbb33\"/><stop offset=\"1\" stop-color=\"#3eff68\"/></linearGradient>\n                  </defs>\n                </svg>\n              </span>\n              <h3 class=\"weflair-resource-card__title\">Ads Checklist</h3>\n              <p class=\"weflair-resource-card__body\">Paid media checklists for campaign setup, tracking, creative QA, and launch readiness.</p>\n              <div class=\"weflair-resource-card__samples\"><span>Google Ads</span><span>LinkedIn</span><span>Meta</span><span>QA</span></div>\n              <span class=\"weflair-resource-card__link\">Open ads checklist <span aria-hidden=\"true\">&rarr;</span></span>\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>"
}